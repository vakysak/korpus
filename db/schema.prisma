generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── DODAVATELÉ ───────────────────────────────────────────────────────────────

model Supplier {
  id       Int     @id @default(autoincrement())
  code     String  @unique @db.VarChar(20)
  name     String  @db.VarChar(100)
  priority Int     @default(99)
  active   Boolean @default(true)

  createdAt DateTime @default(now())

  materials      Material[]
  hardware       Hardware[]
  priceListItems PriceListItem[]
  importLogs     ImportLog[]
  orderItems     OrderItem[]
}

// ─── MATERIÁLY ────────────────────────────────────────────────────────────────

model Material {
  id           Int              @id @default(autoincrement())
  supplierId   Int
  supplierCode String           @db.VarChar(50)
  name         String           @db.VarChar(150)
  category     MaterialCategory
  thickness    Decimal          @db.Decimal(6, 2)
  widthMm      Int?
  heightMm     Int?
  inStock      Boolean          @default(true)
  active       Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  priceListItems PriceListItem[]
  orderItems     OrderItem[]

  @@unique([supplierId, supplierCode])
}

enum MaterialCategory {
  BOARD
  HDF
  EDGE
  FRONT
}

// ─── KOVÁNÍ ───────────────────────────────────────────────────────────────────

model Hardware {
  id           Int          @id @default(autoincrement())
  supplierId   Int
  supplierCode String       @db.VarChar(50)
  name         String       @db.VarChar(150)
  type         HardwareType
  packQty      Int          @default(1)
  inStock      Boolean      @default(true)
  active       Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  priceListItems PriceListItem[]
  orderItems     OrderItem[]
  orderHandles   Order[]         @relation("OrderHandle")

  @@unique([supplierId, supplierCode])
}

enum HardwareType {
  HINGE
  DRAWER_SLIDE
  HANDLE
  SHELF_PIN
  OTHER
}

// ─── CENÍK ────────────────────────────────────────────────────────────────────

model PriceListItem {
  id         Int       @id @default(autoincrement())
  supplierId Int
  materialId Int?
  hardwareId Int?
  unit       PriceUnit
  price      Decimal   @db.Decimal(10, 4)
  currency   String    @default("CZK") @db.VarChar(3)
  validFrom  DateTime  @default(now())
  validTo    DateTime?

  createdAt DateTime @default(now())

  supplier Supplier  @relation(fields: [supplierId], references: [id])
  material Material? @relation(fields: [materialId], references: [id])
  hardware Hardware? @relation(fields: [hardwareId], references: [id])

  @@index([materialId, validFrom])
  @@index([hardwareId, validFrom])
}

enum PriceUnit {
  M2
  BM
  PC
  PACK
}

// ─── ŠABLONY ──────────────────────────────────────────────────────────────────

model CabinetTemplate {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(100)
  version Int     @default(1)
  rules   Json
  active  Boolean @default(true)

  createdAt DateTime @default(now())

  orders Order[]

  @@unique([name, version])
}

// ─── ZÁKAZNÍCI ────────────────────────────────────────────────────────────────

model Customer {
  id    Int     @id @default(autoincrement())
  name  String  @db.VarChar(150)
  email String? @db.VarChar(150)
  phone String? @db.VarChar(30)
  note  String?

  createdAt DateTime @default(now())

  orders Order[]
}

// ─── OBJEDNÁVKY ───────────────────────────────────────────────────────────────

model Order {
  id         Int         @id @default(autoincrement())
  customerId Int?
  templateId Int?
  status     OrderStatus @default(DRAFT)
  widthMm    Int
  heightMm   Int
  depthMm    Int
  backType   BackType    @default(OVERLAID_HDF)
  totalPrice Decimal     @db.Decimal(10, 2)
  notes      String?     @db.Text

  // Horni skrinka – konfigurace
  shelfCount           Int      @default(1)
  visibleSideLeft      Boolean  @default(false)
  visibleSideRight     Boolean  @default(false)
  topRailEnabled       Boolean  @default(false)
  topRailOverhang      Int      @default(21)
  topRailLed           Boolean  @default(false)
  topRailLedColor      String?  @db.VarChar(30)
  topRailLedControl    String?  @db.VarChar(30)
  bottomRailEnabled    Boolean  @default(false)
  bottomRailLed        Boolean  @default(false)
  bottomRailLedType    String?  @db.VarChar(20)
  bottomRailLedColor   String?  @db.VarChar(30)
  bottomRailLedControl String?  @db.VarChar(30)
  doorType             DoorType @default(HANDLE)
  handleId             Int?
  handleBarHeight      Int?
  hingeOverride        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer?        @relation(fields: [customerId], references: [id])
  template CabinetTemplate? @relation(fields: [templateId], references: [id])
  handle   Hardware?        @relation("OrderHandle", fields: [handleId], references: [id])
  items    OrderItem[]

  @@index([status])
  @@index([createdAt])
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  ORDERED
  IN_PRODUCTION
  DONE
  CANCELLED
}

enum BackType {
  OVERLAID_HDF
  HALF_DADO_HDF
  RECTIFICATION
  OVERLAID_SOLID
  DADO_SOLID
}

enum DoorType {
  HANDLE
  HANDLE_BAR
  TIP_ON
  NONE
}

// ─── POLOŽKY OBJEDNÁVKY (BOM řádky) ───────────────────────────────────────────

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  partName   String   @db.VarChar(100)
  partType   String   @db.VarChar(20)
  materialId Int?
  hardwareId Int?
  widthMm    Int?
  heightMm   Int?
  thickness  Decimal? @db.Decimal(5, 1)
  qty        Decimal  @db.Decimal(10, 4)
  unit       String   @db.VarChar(10)
  unitPrice  Decimal  @db.Decimal(10, 4)
  totalPrice Decimal  @db.Decimal(10, 2)
  supplierId Int?

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  material Material? @relation(fields: [materialId], references: [id])
  hardware Hardware? @relation(fields: [hardwareId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([orderId])
  @@index([supplierId])
}

// ─── IMPORT LOG ───────────────────────────────────────────────────────────────

model ImportLog {
  id         Int          @id @default(autoincrement())
  supplierId Int
  fileName   String       @db.VarChar(255)
  status     ImportStatus @default(OK)
  matAdded   Int          @default(0)
  matUpdated Int          @default(0)
  hwAdded    Int          @default(0)
  hwUpdated  Int          @default(0)
  errorCount Int          @default(0)
  errors     Json?
  createdAt  DateTime     @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
}

enum ImportStatus {
  OK
  PARTIAL
  FAILED
}
