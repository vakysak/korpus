generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── DODAVATELÉ ───────────────────────────────────────────────────────────────

model Supplier {
  id       Int     @id @default(autoincrement())
  code     String  @unique @db.VarChar(20)
  name     String  @db.VarChar(100)
  priority Int     @default(99)
  active   Boolean @default(true)

  createdAt DateTime @default(now())

  materials      Material[]
  hardware       Hardware[]
  priceListItems PriceListItem[]
  importLogs     ImportLog[]
}

// ─── MATERIÁLY ────────────────────────────────────────────────────────────────

model Material {
  id           Int              @id @default(autoincrement())
  supplierId   Int
  supplierCode String           @db.VarChar(50)
  name         String           @db.VarChar(150)
  category     MaterialCategory
  thickness    Decimal          @db.Decimal(6, 2)
  widthMm      Int?
  heightMm     Int?
  inStock      Boolean          @default(true)
  active       Boolean          @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  priceListItems PriceListItem[]

  orderItemsCorpus OrderItem[] @relation("CorpusMaterial")
  orderItemsBack   OrderItem[] @relation("BackMaterial")
  orderItemsFront  OrderItem[] @relation("FrontMaterial")

  @@unique([supplierId, supplierCode])
}

enum MaterialCategory {
  BOARD
  HDF
  EDGE
  FRONT
}

// ─── KOVÁNÍ ───────────────────────────────────────────────────────────────────

model Hardware {
  id           Int          @id @default(autoincrement())
  supplierId   Int
  supplierCode String       @db.VarChar(50)
  name         String       @db.VarChar(150)
  type         HardwareType
  packQty      Int          @default(1)
  inStock      Boolean      @default(true)
  active       Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  priceListItems PriceListItem[]
  bomItems       BomItem[]

  @@unique([supplierId, supplierCode])
}

enum HardwareType {
  HINGE
  DRAWER_SLIDE
  HANDLE
  SHELF_PIN
  OTHER
}

// ─── CENÍK ────────────────────────────────────────────────────────────────────

model PriceListItem {
  id         Int       @id @default(autoincrement())
  supplierId Int
  materialId Int?
  hardwareId Int?
  unit       PriceUnit
  price      Decimal   @db.Decimal(10, 4)
  currency   String    @default("CZK") @db.VarChar(3)
  validFrom  DateTime  @default(now())
  validTo    DateTime?

  createdAt DateTime @default(now())

  supplier Supplier  @relation(fields: [supplierId], references: [id])
  material Material? @relation(fields: [materialId], references: [id])
  hardware Hardware? @relation(fields: [hardwareId], references: [id])

  @@index([materialId, validFrom])
  @@index([hardwareId, validFrom])
}

enum PriceUnit {
  M2
  BM
  PC
  PACK
}

// ─── ŠABLONY ──────────────────────────────────────────────────────────────────

model CabinetTemplate {
  id      Int     @id @default(autoincrement())
  name    String  @db.VarChar(100)
  version Int     @default(1)
  rules   Json
  active  Boolean @default(true)

  createdAt DateTime @default(now())

  orderItems OrderItem[]
}

// ─── ZÁKAZNÍCI ────────────────────────────────────────────────────────────────

model Customer {
  id    Int     @id @default(autoincrement())
  name  String  @db.VarChar(150)
  email String? @db.VarChar(150)
  phone String? @db.VarChar(30)
  note  String?

  createdAt DateTime @default(now())

  orders Order[]
}

// ─── OBJEDNÁVKY ───────────────────────────────────────────────────────────────

model Order {
  id         Int         @id @default(autoincrement())
  customerId Int?
  status     OrderStatus @default(DRAFT)
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer Customer?   @relation(fields: [customerId], references: [id])
  items    OrderItem[]
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PRODUCTION
  DONE
  CANCELLED
}

// ─── POLOŽKY OBJEDNÁVKY ───────────────────────────────────────────────────────

model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int
  templateId      Int
  widthMm         Int
  heightMm        Int
  depthMm         Int
  qty             Int      @default(1)
  backType        BackType @default(OVERLAID_HDF)
  materialId      Int
  materialBackId  Int
  materialFrontId Int
  snapshotBom     Json?

  createdAt DateTime @default(now())

  order          Order           @relation(fields: [orderId], references: [id])
  template       CabinetTemplate @relation(fields: [templateId], references: [id])
  materialCorpus Material        @relation("CorpusMaterial", fields: [materialId], references: [id])
  materialBack   Material        @relation("BackMaterial", fields: [materialBackId], references: [id])
  materialFront  Material        @relation("FrontMaterial", fields: [materialFrontId], references: [id])
  bomItems       BomItem[]
}

enum BackType {
  OVERLAID_HDF
  HALF_DADO_HDF
}

// ─── BOM ──────────────────────────────────────────────────────────────────────

model BomItem {
  id          Int         @id @default(autoincrement())
  orderItemId Int
  hardwareId  Int?
  partName    String      @db.VarChar(100)
  partType    BomPartType
  widthMm     Int?
  heightMm    Int?
  thickness   Decimal?    @db.Decimal(6, 2)
  qty         Int         @default(1)
  unitPrice   Decimal?    @db.Decimal(10, 4)
  totalPrice  Decimal?    @db.Decimal(10, 4)

  createdAt DateTime @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  hardware  Hardware? @relation(fields: [hardwareId], references: [id])
}

enum BomPartType {
  BOARD
  EDGE
  HARDWARE
}

// ─── IMPORT LOG ───────────────────────────────────────────────────────────────

model ImportLog {
  id         Int          @id @default(autoincrement())
  supplierId Int
  fileName   String       @db.VarChar(255)
  status     ImportStatus @default(OK)
  matAdded   Int          @default(0)
  matUpdated Int          @default(0)
  hwAdded    Int          @default(0)
  hwUpdated  Int          @default(0)
  errorCount Int          @default(0)
  errors     Json?
  createdAt  DateTime     @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id])
}

enum ImportStatus {
  OK
  PARTIAL
  FAILED
}
